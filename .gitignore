# =============================================================================
# 智能运维平台 .gitignore
# 说明：运行时数据（数据库、密钥、日志、运行时配置）可能包含真实服务器
#       凭据等敏感信息，一律不纳入版本控制；应用首次启动会自动重建。
# =============================================================================

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 构建产物 ----
dist/
build/
dist-portable/
*.tar
*.tar.gz
*.zip

# ---- 运行时数据（含敏感配置，应用首启自动生成）----
data/
backups/

# ---- 日志与临时文件 ----
*.log
*.tmp
_shot_*.png

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 头脑风暴视觉伴侣会话 ----
.superpowers/

# ---- 本地 git worktree ----
.worktrees/
